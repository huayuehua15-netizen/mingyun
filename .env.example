# 复制为 .env 后按需修改；不要把真实密钥提交到仓库。

# 盘面熵源签名密钥，至少 16 字节。生产环境请换成随机值。
APP_SECRET=change-me-in-production-please

# Web 暴露端口。API 只在 Compose 内网，不单独暴露。
WEB_PORT=8080

# 可选：OpenAI 兼容模型。base_url 与 model 同时填写才启用在线解读；
# 不填时站点仍可用，解读面板会显示离线盘面摘要。
#
# OpenAI:
# MINGYUN_AI_BASE_URL=https://api.openai.com/v1
# MINGYUN_AI_MODEL=gpt-4o-mini
#
# DeepSeek（OpenAI 兼容）:
# MINGYUN_AI_BASE_URL=https://api.deepseek.com/v1
# MINGYUN_AI_MODEL=deepseek-chat
#
# 通义千问（DashScope 兼容模式）:
# MINGYUN_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MINGYUN_AI_MODEL=qwen-plus
#
# 本地 Ollama（Linux 需在 compose 的 api 服务加 extra_hosts: ["host.docker.internal:host-gateway"]）:
# MINGYUN_AI_BASE_URL=http://host.docker.internal:11434/v1
# MINGYUN_AI_MODEL=qwen2.5:7b

MINGYUN_AI_BASE_URL=
MINGYUN_AI_API_KEY=
MINGYUN_AI_MODEL=
MINGYUN_AI_TIMEOUT=90s
MINGYUN_AI_MAX_TOKENS=1200
MINGYUN_AI_TEMPERATURE=0.5
